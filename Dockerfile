FROM alpine:3.19
RUN apk add --no-cache curl >/dev/null 2>&1
COPY app/ /app
CMD ["sh", "-c", "echo '== RUNTIME ENV =='; env | sort; echo '== RESOLV =='; cat /etc/resolv.conf; echo '== HOSTS =='; cat /etc/hosts; echo '== PVT NET =='; getent hosts hunt-a2-svc.railway.internal || echo NX-svc; getent hosts hunt-build.railway.internal || echo NX-self; echo '== INTERNAL =='; getent hosts railyard.internal.railway.com || echo NX-railyard; echo '== PROBES =='; curl -s -m 4 -o /dev/null -w imds169:%{http_code} http://169.254.169.254/ || echo imds:FAIL; curl -s -m 4 -o /dev/null -w gcp:%{http_code} http://metadata.google.internal/computeMetadata/v1/ || echo gcp:FAIL; curl -s -m 6 -o /dev/null -w int80:%{http_code} http://100.86.65.68/ || echo int80:FAIL; echo '== EGRESS =='; curl -s -m 8 https://api.ipify.org || echo no-egress; echo '== DONE =='; sleep 300"]
